# ZacOS 9 is built against wlroots 0.18. The two compatibility patches
# cover libinput's newer switch enum and GCC's const-correct strchr result.
pkgname=wlroots0.18
pkgver=0.18.3
pkgrel=2
pkgdesc='Modular Wayland compositor library, ABI 0.18'
url='https://gitlab.freedesktop.org/wlroots/wlroots'
license=('MIT')
arch=('x86_64')
depends=('libdisplay-info.so' 'libglvnd' 'libinput' 'liblcms2.so' 'libliftoff.so' 'libpixman-1.so'
         'libseat.so' 'libudev.so' 'libvulkan.so' 'libwayland-client.so' 'libwayland-server.so'
         'libxcb' 'libxkbcommon.so' 'opengl-driver' 'xcb-util-errors' 'xcb-util-renderutil' 'xcb-util-wm')
makedepends=('glslang' 'meson' 'ninja' 'systemd' 'vulkan-headers' 'wayland-protocols' 'xorg-xwayland')
optdepends=('xorg-xwayland: Xwayland support')
provides=('libwlroots-0.18.so')
conflicts=('wlroots')
source=("wlroots-${pkgver}.tar.gz::${url}/-/archive/${pkgver}/wlroots-${pkgver}.tar.gz"
        'Revert-layer-shell-error-on-0-dimension-without-anch.patch'
        'libinput-keypad-slide.patch'
        'const-strchr-result.patch')
sha256sums=('e9af941648cdc72b2ea39ceb6f1d54905f9038d968415a197df7d168923e415c'
            '570224bf7293f6d57e713f5acbf17a64ddf6daa41112f14ea028dd9ba7a82814'
            '80ae925c16042f8b7d732b424bbfcd0c54bc7c602d9038182cd95ceb1f57cdc8'
            'dd3282808c1ef12e3dd67aca5aa3ee28d01b40873c63b1e5634d0396744b8b69')

prepare() {
  cd "wlroots-${pkgver}"
  patch -Np1 -i "${srcdir}/Revert-layer-shell-error-on-0-dimension-without-anch.patch"
  patch -Np1 -i "${srcdir}/libinput-keypad-slide.patch"
  patch -Np1 -i "${srcdir}/const-strchr-result.patch"
}

build() {
  arch-meson "wlroots-${pkgver}" build -Dwerror=false
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
  install -Dm644 "wlroots-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
